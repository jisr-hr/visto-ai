# Copy to .env (git-ignored). Placeholder values only: write your own.
# Read by compose.yaml and by config.local.yml.

# The password of the Postgres container.
POSTGRES_PASSWORD=change-me-db-password
# The secret set on the GitHub App's webhook. `npm run app:create` can write this and APP_PRIVATE_KEY to a file.
WEBHOOK_SECRET=change-me-webhook-secret
# The GitHub App's RSA private key, written on one line with \n for each line break.
APP_PRIVATE_KEY=change-me-private-key-on-one-line
# Only if config.local.yml names who may sign in through GitHub: the client secret generated on the GitHub App's settings page.
# APP_CLIENT_SECRET=change-me-client-secret
# The Postgres URL the service connects to. Use the same password as above.
DATABASE_URL=postgres://postgres:change-me-db-password@db:5432/visto
# The model API key (named by the model block of config.local.yml). Every review spends money from this account.
OPENROUTER_API_KEY=change-me-model-key
# Only if you switch on the scorer block of config.local.yml.
# SCORER_API_KEY=change-me-scorer-key
# Only if config.local.yml writes auditKey (with none, the service generates the audit sample's key and keeps it in its
# database): the audit sample's key, at least 32 characters, for example the output of openssl rand -hex 32. A new key draws
# every pull request again.
# The value below is too short on purpose: the service refuses it, so it is never used as a key.
# AUDIT_KEY=change-me-audit-key
# Optional: a URL (http or https) that gets the alerts: model_error, model_ok, spend_80, spend_limit, cost_unknown, redelivery_failed, feature_off, gate_check_failed, gate_bypass, extension_error, extension_ok, mcp_error, mcp_ok, memory_error, memory_ok, learning_stale, lessons_stale, dismissal_failed and stale_approval_merged.
# ALERT_WEBHOOK_URL=https://alerts.example.test/hook
# Only if you switch on the extensions block of config.local.yml with the example module: the secret a caller of its feedback route must send.
# EXAMPLE_FEEDBACK_SECRET=change-me-example-secret
# Only if you switch on the mcpServers block of config.local.yml as the example writes it: the header the docs server is sent.
# DOCS_MCP_AUTHORIZATION=Bearer change-me
