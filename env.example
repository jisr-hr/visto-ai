# Copy to .env (git-ignored). Placeholder values only: write your own.
# Read by compose.yaml and by config.local.yml.

# The password of the Postgres container.
POSTGRES_PASSWORD=change-me-db-password
# The secret set on the GitHub App's webhook. `npm run app:create` can write this and APP_PRIVATE_KEY to a file.
WEBHOOK_SECRET=change-me-webhook-secret
# The GitHub App's RSA private key, written on one line with \n for each line break.
APP_PRIVATE_KEY=change-me-private-key-on-one-line
# The Postgres URL the service connects to. Use the same password as above.
DATABASE_URL=postgres://postgres:change-me-db-password@db:5432/visto
# The model API key (named by the model block of config.local.yml). Every review spends money from this account.
OPENROUTER_API_KEY=change-me-model-key
# Only if you switch on the scorer block of config.local.yml.
# SCORER_API_KEY=change-me-scorer-key
# Optional: a URL (http or https) that gets the alerts: model_error, model_ok, spend_80, spend_limit, cost_unknown, redelivery_failed, feature_off, gate_check_failed and gate_bypass.
# ALERT_WEBHOOK_URL=https://alerts.example.test/hook
